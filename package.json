{
  "name": "hub-steam-manager",
  "version": "1.0.0",
  "description": "All-in-one Steam manager and OpenSteamTool",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hubsteam.manager",
    "productName": "HUB Steam Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HUB Steam Manager"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
